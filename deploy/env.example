# Kopioi palvelimelle: /etc/em2028.env   (chmod 600, omistaja root)
# APP_SECRET: luo komennolla  openssl rand -hex 32  ja varmuuskopioi erikseen. Jos se katoaa, salasanat ja sähköpostit menetetään.
APP_SECRET=
BASE_URL=https://veikkaus.example.com
ADDR=127.0.0.1:8080
TRUST_PROXY=true
DB_PATH=/var/lib/em2028/em2028.db
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EM 2028 <no-reply@veikkaus.example.com>"

# Suositeltu tuotannossa: kaikki ylläpitäjät käyttävät kaksivaiheista kirjautumista (TOTP).
REQUIRE_ADMIN_2FA=true
# Valinnainen: Discord/Slack-yhteensopiva webhook ilmoituksille (uusi tulos, muistutukset). Ei henkilötietoja.
#NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Valinnainen: tarkista rekisteröityessä, onko salasana vuotanut (Have I Been Pwned, k-anonymiteetti: lähtee vain 5 merkkiä tiivisteestä).
#PWNED_CHECK=true
